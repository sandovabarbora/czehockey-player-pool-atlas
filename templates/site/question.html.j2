{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import limit_short, meta_line with context %}
{% block title %}{{ cur.title }} — Czech Hockey Atlas{% endblock %}
{% block description %}{{ cur.description }}{% endblock %}
{% block canonical %}https://hockey.bsandova.com/{{ cur.url }}{% endblock %}
{% block scripts %}<script defer src="{{ prefix }}charts.js?v={{ v }}"></script>{% endblock %}

{% block body %}
<main id="content" class="qpage">
<section class="slide" id="{{ cur.id }}">
  <div class="container">
    {% filter indent(4) %}
{% include "questions/" ~ cur.id ~ ".html.j2" %}
    {% endfilter %}
    {{ meta_line(prefix) }}
    <nav class="q-pager" aria-label="Questions">
      {% if prev %}<a class="q-pager-prev" href="{{ prefix }}{{ prev.url }}"><span class="q-pager-label">← Question {{ prev.n }}</span>{{ prev.label }}</a>{% else %}<span></span>{% endif %}
      <a class="q-pager-home" href="{{ prefix }}#take">Summary</a>
      {% if next %}<a class="q-pager-next" href="{{ prefix }}{{ next.url }}"><span class="q-pager-label">Question {{ next.n }} →</span>{{ next.label }}</a>{% else %}<span></span>{% endif %}
    </nav>
  </div>
</section>
</main>
{% endblock %}
