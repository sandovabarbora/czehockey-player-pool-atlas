<!DOCTYPE html>
<html lang="en" data-home="CZE">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{% endblock %}</title>
  <meta name="description" content="{% block description %}{% endblock %}">
  <link rel="canonical" href="{% block canonical %}{% endblock %}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ prefix }}style.css?v={{ v }}">
  <link rel="stylesheet" href="{{ prefix }}modern.css?v={{ v }}">
  {% if page in ("question", "players") %}<script defer src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>{% endif %}
  {% block scripts %}{% endblock %}
  {% block head_extra %}{% endblock %}
</head>
<body id="top"{% block body_attrs %}{% endblock %}>
<nav class="topbar" aria-label="Navigation">
  <a class="topbar-brand" href="{{ prefix }}">Czech Hockey <span>Atlas</span></a>
  <div class="topbar-links">
    <a href="{{ prefix }}"{% if page == 'home' %} aria-current="page"{% endif %}>Summary</a>
    <details class="nav-q" data-nav-q>
      <summary{% if page == 'question' %} class="is-current"{% endif %}>Questions</summary>
      <ol class="nav-q-list">
        {% for q in questions %}
        <li><a href="{{ prefix }}{{ q.url }}"{% if cur is defined and cur.id == q.id %} aria-current="page"{% endif %}><span class="nav-q-n">{{ loop.index }}</span>{{ q.label }}</a></li>
        {% endfor %}
      </ol>
    </details>
    <a href="{{ prefix }}methodology/"{% if page == 'methodology' %} aria-current="page"{% endif %}>Methodology</a>
    <a href="{{ prefix }}players/"{% if page == 'players' %} aria-current="page"{% endif %}>Players</a>
  </div>
</nav>
<script>
  /* the Questions menu: close on a click outside it or on Escape */
  (function () {
    var d = document.querySelector('[data-nav-q]');
    if (!d) return;
    document.addEventListener('click', function (e) { if (d.open && !d.contains(e.target)) d.open = false; });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && d.open) { d.open = false; d.querySelector('summary').focus(); } });
  })();
</script>
{% block body %}{% endblock %}
<footer>
  <div class="container">
    <div class="role-block">
      <p class="role-kicker">Built by Barbora Šandová — data &amp; cloud engineer</p>
      <p class="role-body">An exploratory, descriptive atlas built from public statistics; the fetchers, the snapshot, the analysis and these pages are one repository. It makes no forecasts and gives no selection advice.</p>
      <p class="role-author">
        <span class="role-author-name">Barbora Šandová</span>
        <span class="role-author-contact">
          <a href="mailto:hello@bsandova.com">hello@bsandova.com</a>
          &middot;
          <a href="https://github.com/sandovabarbora/czehockey-player-pool-atlas">github.com/sandovabarbora/czehockey-player-pool-atlas</a>
        </span>
      </p>
    </div>
    <p class="rendered-at">Built {{ build_date_long }} from the snapshot in <code>data/snapshot/</code> and the analysis in <code>outputs/</code>.</p>
  </div>
</footer>
</body>
</html>
